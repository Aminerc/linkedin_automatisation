# ═══════════════════════════════════════════════════════════════════════════
# Configuration LinkedIn Automation Bot
# Copie ce fichier en .env puis remplis les valeurs : cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════

# ─── Anthropic Claude API (génération de contenu) ───────────────────────────
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── Perplexity API (génération de contenu, optionnel) ──────────────────────
# https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-...

# ─── Telegram Bot ────────────────────────────────────────────────────────────
# Token obtenu depuis @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdef...
# Ton chat ID personnel (lance get_chat_id.py pour le trouver)
TELEGRAM_CHAT_ID=123456789

# ─── LinkedIn — API officielle (publication) ─────────────────────────────────
# Créer une app sur https://developer.linkedin.com/ avec les produits :
#   - "Share on LinkedIn"  (scope w_member_social)
#   - "Sign In with LinkedIn using OpenID Connect"  (scopes openid, profile)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Token OAuth généré par get_linkedin_token.py (expire ~60 jours)
LINKEDIN_ACCESS_TOKEN=
# ID membre opaque retourné par /v2/userinfo (champ "sub") — voir README
LINKEDIN_PERSON_ID=

# ─── Branding des visuels générés ────────────────────────────────────────────
BRAND_NAME=Votre Nom
BRAND_TAGLINE=Automatisation & Data pour la finance

# ─── LinkedIn — legacy (cookies, optionnel) ──────────────────────────────────
# Utilisé uniquement en fallback texte si LINKEDIN_ACCESS_TOKEN est absent
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
